{% comment %}
  Custom Footer
  - Shopify native newsletter form
  - Shopify localization form
  - Dynamic footer menus
  - Shopify enabled payment icons
  - Responsive accordion navigation
{% endcomment %}

{%- liquid
  assign footer_id = 'CustomFooter-' | append: section.id
  assign footer_font = section.settings.font
-%}

{% style %}
  {{ footer_font | font_face: font_display: 'swap' }}

  *:focus-visible{
    outline: none;
    outline-offset: none;
    box-shadow: none;
  }

  #{{ footer_id }} {
    --cf-bg: {{ section.settings.background_color }};
    --cf-text: {{ section.settings.text_color }};
    --cf-muted: {{ section.settings.muted_color }};
    --cf-border: {{ section.settings.border_color }};
    --cf-accent: {{ section.settings.accent_color }};
    --cf-button-bg: {{ section.settings.button_background }};
    --cf-button-text: {{ section.settings.button_text_color }};
    --cf-max-width: {{ section.settings.content_width }}px;
    --cf-font-size: {{ section.settings.font_size }}px;
    --cf-heading-size: {{ section.settings.heading_size }}px;
    --cf-gap: {{ section.settings.column_gap }}px;
    --cf-padding-top: {{ section.settings.padding_top }}px;
    --cf-padding-bottom: {{ section.settings.padding_bottom }}px;

    background: var(--cf-bg);
    color: var(--cf-text);
    font-family: {{ footer_font.family }}, {{ footer_font.fallback_families }};
    font-style: {{ footer_font.style }};
    font-weight: {{ footer_font.weight }};
    -webkit-font-smoothing: antialiased;
  }

  #{{ footer_id }} *,
  #{{ footer_id }} *::before,
  #{{ footer_id }} *::after {
    box-sizing: border-box;
  }

  #{{ footer_id }} a {
    color: inherit;
    text-decoration: none;
  }

  #{{ footer_id }} .cf__container {
    width: 100%;
    max-width: var(--cf-max-width);
    margin: 0 auto;
    padding: var(--cf-padding-top) 24px var(--cf-padding-bottom);
  }

  /* Newsletter */

  #{{ footer_id }} .cf__newsletter {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    padding-bottom: 36px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--cf-border);
  }

  #{{ footer_id }} .cf__newsletter-content {
    flex: 1;
    min-width: 0;
  }

  #{{ footer_id }} .cf__newsletter-title {
    margin: 0;
    font-size: 28px;
    line-height: 1.25;
    font-weight: 600;
  }

  #{{ footer_id }} .cf__newsletter-description {
    margin: 8px 0 0;
    color: var(--cf-muted);
    font-size: var(--cf-font-size);
    line-height: 1.6;
  }

  #{{ footer_id }} .cf__newsletter-form-wrap {
    width: 100%;
    max-width: 480px;
  }

  #{{ footer_id }} .cf__newsletter-form {
    display: flex;
    padding: 5px;
    border: 1px solid var(--cf-border);
    border-radius: {{ section.settings.input_radius }}px;
    background: rgba(255, 255, 255, 0.08);
  }

  #{{ footer_id }} .cf__newsletter-input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border: 0;
    outline: none;
    background: transparent;
    color: var(--cf-text);
    font: inherit;
    font-size: 15px;
  }

  #{{ footer_id }} .cf__newsletter-input::placeholder {
    color: var(--cf-muted);
    opacity: 1;
  }

  #{{ footer_id }} .cf__newsletter-button {
    flex: none;
    min-height: 44px;
    padding: 0 24px;
    border: 0;
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--cf-button-bg);
    color: var(--cf-button-text);
    font: inherit;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  #{{ footer_id }} .cf__newsletter-button:hover {
    opacity: 0.85;
  }

  #{{ footer_id }} .cf__newsletter-message {
    margin: 10px 0 0;
    font-size: 13px;
    line-height: 1.5;
  }

  #{{ footer_id }} .cf__newsletter-message:empty {
    display: none;
  }

  #{{ footer_id }} .cf__newsletter-legal {
    margin: 10px 0 0;
    color: var(--cf-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  #{{ footer_id }} .cf__newsletter-legal a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  /* Main footer */

  #{{ footer_id }} .cf__top {
    display: grid;
    grid-template-columns: minmax(200px, 1.2fr) 4fr;
    gap: 40px;
  }

  #{{ footer_id }} .cf__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  #{{ footer_id }} .cf__logo {
    display: inline-block;
    line-height: 0;
  }

  #{{ footer_id }} .cf__logo img {
    display: block;
    width: {{ section.settings.logo_width }}px;
    max-width: 100%;
    height: auto;
  }

  #{{ footer_id }} .cf__brand-name {
    margin: 0;
    font-size: 26px;
    line-height: 1.2;
    font-weight: 600;
  }

  #{{ footer_id }} .cf__rating {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 32px;
    font-size: 14px;
  }

  #{{ footer_id }} .cf__rating-stars {
    position: relative;
    display: inline-block;
    width: 92px;
    height: 18px;
    background: rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }

  #{{ footer_id }} .cf__rating-stars::before,
  #{{ footer_id }} .cf__rating-stars::after {
    content: '★★★★★';
    position: absolute;
    inset: 0;
    font-size: 18px;
    line-height: 18px;
    letter-spacing: 0;
    white-space: nowrap;
  }

  #{{ footer_id }} .cf__rating-stars::before {
    color: rgba(255, 255, 255, 0.3);
  }

  #{{ footer_id }} .cf__rating-stars::after {
    width: var(--cf-rating);
    overflow: hidden;
    color: {{ section.settings.rating_star_color }};
  }

  #{{ footer_id }} .cf__rating-text {
    color: var(--cf-muted);
  }

  #{{ footer_id }} .cf__rating-text strong {
    color: var(--cf-text);
  }

  #{{ footer_id }} .cf__tagline {
    max-width: 320px;
    margin: 0;
    color: var(--cf-muted);
    font-size: var(--cf-font-size);
    line-height: 1.6;
  }

  /* Menu columns */

  #{{ footer_id }} .cf__menus {
    display: grid;
    grid-template-columns: repeat({{ section.settings.menu_columns }}, minmax(0, 1fr));
    gap: var(--cf-gap);
  }

  #{{ footer_id }} .cf__menu {
    min-width: 0;
  }

  #{{ footer_id }} .cf__menu-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 0;
    margin: 0 0 14px;
    padding: 0;
    font-size: var(--cf-heading-size);
    line-height: 1.4;
    font-weight: 700;
    list-style: none;
  }

  #{{ footer_id }} .cf__menu-heading::-webkit-details-marker {
    display: none;
  }

  #{{ footer_id }} .cf__menu-chevron {
    display: none;
    width: 9px;
    height: 9px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.2s ease;
  }

  #{{ footer_id }} .cf__menu[open] .cf__menu-chevron {
    transform: rotate(225deg);
  }

  #{{ footer_id }} .cf__menu-links {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #{{ footer_id }} .cf__menu-links li + li {
    margin-top: 8px;
  }

  #{{ footer_id }} .cf__menu-links a {
    display: inline-block;
    color: var(--cf-muted);
    font-size: var(--cf-font-size);
    line-height: 1.5;
    transition: color 0.2s ease;
  }

  #{{ footer_id }} .cf__menu-links a:hover {
    color: var(--cf-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  #{{ footer_id }} .cf__menu-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    margin-top: 14px;
    padding: 0 18px;
    border: 1px solid currentColor;
    border-radius: {{ section.settings.button_radius }}px;
    color: var(--cf-text);
    font-size: 13px;
    font-weight: 600;
    transition: background 0.2s ease, color 0.2s ease;
  }

  #{{ footer_id }} .cf__menu-button:hover {
    background: var(--cf-text);
    color: var(--cf-bg);
  }

  #{{ footer_id }} .cf__menu-note {
    margin: 10px 0 0;
    color: var(--cf-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  /* Bottom */

  #{{ footer_id }} .cf__bottom {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 20px;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid var(--cf-border);
  }

  #{{ footer_id }} .cf__localization {
    display: flex;
    align-items: center;
  }

  #{{ footer_id }} .cf__localization-form {
    position: relative;
  }

  #{{ footer_id }} .cf__localization-select {
    min-height: 40px;
    padding: 0 26px 0 4px;
    border: 0;
    outline: none;
    appearance: none;
    background: transparent;
    color: var(--cf-text);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  #{{ footer_id }} .cf__localization-select option {
    color: #222;
    background: #fff;
  }

  #{{ footer_id }} .cf__localization-form::after {
    content: '';
    position: absolute;
    top: 15px;
    right: 7px;
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg);
    pointer-events: none;
  }

  #{{ footer_id }} .cf__social {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 18px;
  }

  #{{ footer_id }} .cf__social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 32px;
    min-height: 32px;
    color: var(--cf-text);
    font-size: 12px;
    font-weight: 700;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  #{{ footer_id }} .cf__social-link:hover {
    opacity: 1;
  }

  #{{ footer_id }} .cf__bottom-right {
    text-align: right;
  }

  #{{ footer_id }} .cf__copyright,
  #{{ footer_id }} .cf__legal {
    margin: 0;
    color: var(--cf-muted);
    font-size: 12px;
    line-height: 1.6;
  }

  #{{ footer_id }} .cf__legal {
    margin-top: 3px;
  }

  #{{ footer_id }} .cf__payments {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    flex-wrap: wrap;
    gap: 6px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  #{{ footer_id }} .cf__payments li {
    display: flex;
    align-items: center;
  }

  #{{ footer_id }} .cf__payments svg {
    display: block;
    width: 38px;
    height: 24px;
  }

  @media (max-width: 989px) {
    #{{ footer_id }} .cf__container {
      padding: 36px 20px 32px;
    }

    #{{ footer_id }} .cf__newsletter {
      flex-direction: column;
      align-items: center;
      gap: 16px;
      margin-bottom: 28px;
      padding-bottom: 28px;
      text-align: center;
    }

    #{{ footer_id }} .cf__newsletter-title {
      font-size: 24px;
    }

    #{{ footer_id }} .cf__newsletter-form-wrap {
      max-width: 500px;
    }

    #{{ footer_id }} .cf__top {
      display: flex;
      flex-direction: column;
      gap: 28px;
    }

    #{{ footer_id }} .cf__brand {
      align-items: center;
      text-align: center;
      padding-bottom: 8px;
    }

    #{{ footer_id }} .cf__tagline {
      max-width: 360px;
    }

    #{{ footer_id }} .cf__menus {
      display: block;
      border-top: 1px solid var(--cf-border);
    }

    #{{ footer_id }} .cf__menu {
      border-bottom: 1px solid var(--cf-border);
    }

    #{{ footer_id }} .cf__menu-heading {
      min-height: 56px;
      margin: 0;
      padding: 0 4px;
      cursor: pointer;
      font-size: 16px;
    }

    #{{ footer_id }} .cf__menu-chevron {
      display: block;
    }

    #{{ footer_id }} .cf__menu-body {
      padding: 0 4px 18px;
    }

    #{{ footer_id }} .cf__menu-links li + li {
      margin-top: 10px;
    }

    #{{ footer_id }} .cf__bottom {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
      margin-top: 24px;
      text-align: center;
    }

    #{{ footer_id }} .cf__bottom-right {
      text-align: center;
    }

    #{{ footer_id }} .cf__payments {
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    #{{ footer_id }} .cf__container {
      padding-right: 16px;
      padding-left: 16px;
    }

    #{{ footer_id }} .cf__newsletter-form {
      gap: 5px;
    }

    #{{ footer_id }} .cf__newsletter-input {
      padding: 0 10px;
      font-size: 14px;
    }

    #{{ footer_id }} .cf__newsletter-button {
      padding: 0 16px;
      font-size: 12px;
    }

    #{{ footer_id }} .cf__social {
      gap: 8px 14px;
    }
  }
{% endstyle %}

<footer id="{{ footer_id }}" class="cf">
  <div class="cf__container">
    {% if section.settings.show_newsletter %}
      <div class="cf__newsletter">
        <div class="cf__newsletter-content">
          {% if section.settings.newsletter_heading != blank %}
            <h2 class="cf__newsletter-title">
              {{ section.settings.newsletter_heading }}
            </h2>
          {% endif %}

          {% if section.settings.newsletter_description != blank %}
            <div class="cf__newsletter-description">
              {{ section.settings.newsletter_description }}
            </div>
          {% endif %}
        </div>

        <div class="cf__newsletter-form-wrap">
          {%- assign newsletter_form_id = 'FooterNewsletter-' | append: section.id -%}

          {% form 'customer', id: newsletter_form_id, class: 'cf__newsletter-form' %}
            <input type="hidden" name="contact[tags]" value="newsletter">

            <label class="visually-hidden" for="FooterEmail-{{ section.id }}">
              {{ 'newsletter.label' | t | default: 'Email' }}
            </label>

            <input
              id="FooterEmail-{{ section.id }}"
              class="cf__newsletter-input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.newsletter_placeholder | escape }}"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              required
              {% if form.errors %}
                aria-invalid="true"
                aria-describedby="FooterNewsletterError-{{ section.id }}"
              {% endif %}
            >

            <button class="cf__newsletter-button" type="submit">
              {{ section.settings.newsletter_button }}
            </button>
          {% endform %}

          {% if form.posted_successfully? %}
            <p class="cf__newsletter-message" role="status">
              {{ section.settings.newsletter_success }}
            </p>
          {% elsif form.errors %}
            <p
              id="FooterNewsletterError-{{ section.id }}"
              class="cf__newsletter-message"
              role="alert"
            >
              {{ form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email }}
            </p>
          {% endif %}

          {% if section.settings.newsletter_legal != blank %}
            <p class="cf__newsletter-legal">
              {{ section.settings.newsletter_legal }}
              {% if section.settings.privacy_page != blank %}
                <a href="{{ section.settings.privacy_page.url }}">
                  {{ section.settings.privacy_link_text }}
                </a>
              {% endif %}
            </p>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <div class="cf__top">
      <div class="cf__brand">
        {% if section.settings.logo != blank %}
          <a
            class="cf__logo"
            href="{{ section.settings.logo_link | default: routes.root_url }}"
            aria-label="{{ shop.name | escape }}"
          >
            {{
              section.settings.logo
              | image_url: width: 600
              | image_tag: widths: '120, 160, 240, 320, 480, 600', loading: 'lazy', alt: shop.name
            }}
          </a>
        {% elsif section.settings.show_brand_name %}
          <a
            class="cf__brand-name"
            href="{{ routes.root_url }}"
          >
            {{ shop.name }}
          </a>
        {% endif %}

        {% if section.settings.show_rating %}
          <a class="cf__rating" href="{{ section.settings.rating_link | default: '#' }}">
            <span
              class="cf__rating-stars"
              style="--cf-rating: {{ section.settings.rating_value | times: 20 }}%;"
              aria-label="{{ section.settings.rating_value }} out of 5 stars"
            ></span>

            <span class="cf__rating-text">
              <strong>{{ section.settings.rating_value }}</strong>
              {% if section.settings.review_count != blank %}
                ·
                <u>
                  {{- section.settings.review_count }}
                  {{ section.settings.review_label -}}
                </u>
              {% endif %}
            </span>
          </a>
        {% endif %}

        {% if section.settings.tagline != blank %}
          <p class="cf__tagline">
            {{ section.settings.tagline }}
          </p>
        {% endif %}
      </div>

      <div class="cf__menus">
        {% for block in section.blocks %}
          {% if block.type == 'footer_menu' %}
            <details class="cf__menu" open data-cf-menu {{ block.shopify_attributes }}>
              <summary class="cf__menu-heading">
                <span>{{ block.settings.heading | escape }}</span>
                <span class="cf__menu-chevron" aria-hidden="true"></span>
              </summary>

              <div class="cf__menu-body">
                {% if block.settings.menu != blank %}
                  <ul class="cf__menu-links">
                    {% for link in block.settings.menu.links %}
                      <li>
                        <a href="{{ link.url }}">
                          {{ link.title | escape }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}

                {% if block.settings.button_label != blank and block.settings.button_link != blank %}
                  <a class="cf__menu-button" href="{{ block.settings.button_link }}">
                    {{ block.settings.button_label | escape }}
                  </a>
                {% endif %}

                {% if block.settings.note != blank %}
                  <p class="cf__menu-note">
                    {{ block.settings.note }}
                  </p>
                {% endif %}
              </div>
            </details>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="cf__bottom">
      {% if section.settings.show_country_selector %}
        <div class="cf__localization">
          {%- assign localization_form_id = 'FooterLocalization-' | append: section.id -%}

          {% form 'localization', id: localization_form_id, class: 'cf__localization-form' %}
            <label class="visually-hidden" for="FooterCountry-{{ section.id }}"> Country / region </label>

            <select
              id="FooterCountry-{{ section.id }}"
              class="cf__localization-select"
              name="country_code"
              aria-label="Country / region"
              onchange="this.form.submit()"
            >
              {% for country in localization.available_countries %}
                <option
                  value="{{ country.iso_code }}"
                  {% if country.iso_code == localization.country.iso_code %}
                    selected
                  {% endif %}
                >
                  {{ country.name }} ({{ country.currency.iso_code }}
                  {{ country.currency.symbol }})
                </option>
              {% endfor %}
            </select>
          {% endform %}
        </div>
      {% endif %}

      {% if section.settings.show_social %}
        <div class="cf__social">
          {% if settings.social_instagram_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_instagram_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              >Instagram</a
            >
          {% endif %}

          {% if settings.social_tiktok_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_tiktok_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="TikTok"
              >TikTok</a
            >
          {% endif %}

          {% if settings.social_facebook_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_facebook_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Facebook"
              >Facebook</a
            >
          {% endif %}

          {% if settings.social_pinterest_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_pinterest_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Pinterest"
              >Pinterest</a
            >
          {% endif %}

          {% if settings.social_youtube_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_youtube_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="YouTube"
              >YouTube</a
            >
          {% endif %}

          {% if settings.social_x_link != blank %}
            <a
              class="cf__social-link"
              href="{{ settings.social_x_link }}"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="X"
              >X</a
            >
          {% endif %}
        </div>
      {% endif %}

      <div class="cf__bottom-right">
        {% if section.settings.show_copyright %}
          <p class="cf__copyright">
            {{ section.settings.copyright_text | default: '© ' | escape }}
            {% if section.settings.copyright_text == blank %}
              {{ 'now' | date: '%Y' }}
              {{ shop.name }}. All rights reserved.
            {% endif %}
          </p>
        {% endif %}

        {% if section.settings.legal_address != blank %}
          <p class="cf__legal">
            {{ section.settings.legal_address }}
          </p>
        {% endif %}

        {% if section.settings.show_payment_icons %}
          <ul class="cf__payments" role="list" aria-label="Payment methods">
            {% for type in shop.enabled_payment_types %}
              <li>
                {{ type | payment_type_svg_tag: class: 'cf__payment-icon' }}
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
</footer>

<script>
  (function () {
    var footer = document.getElementById('CustomFooter-{{ section.id }}');
    if (!footer || footer.dataset.initialized === 'true') return;

    footer.dataset.initialized = 'true';

    var mediaQuery = window.matchMedia('(min-width: 990px)');
    var menus = footer.querySelectorAll('[data-cf-menu]');

    function syncMenus() {
      menus.forEach(function (menu) {
        menu.open = mediaQuery.matches;
      });
    }

    syncMenus();

    if (mediaQuery.addEventListener) {
      mediaQuery.addEventListener('change', syncMenus);
    } else if (mediaQuery.addListener) {
      mediaQuery.addListener(syncMenus);
    }

    document.addEventListener('shopify:section:unload', function (event) {
      if (event.target && event.target.contains(footer)) {
        footer.dataset.initialized = 'false';
        if (mediaQuery.removeEventListener) {
          mediaQuery.removeEventListener('change', syncMenus);
        } else if (mediaQuery.removeListener) {
          mediaQuery.removeListener(syncMenus);
        }
      }
    });
  })();
</script>

