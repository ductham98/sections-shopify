{%- liquid
  assign bg_color = section.settings.bg_color | default: '#111827'
  assign text_color = section.settings.text_color | default: '#ffffff'
  assign highlight_color = section.settings.highlight_color | default: '#fbbf24'
  assign speed = section.settings.speed | default: 25
-%}

<div
  id="shopify-section-ticker-{{ section.id }}"
  class="announcement-ticker-wrapper"
  style="
    --ticker-bg: {{ bg_color }};
    --ticker-text: {{ text_color }};
    --ticker-highlight: {{ highlight_color }};
    --ticker-speed: {{ speed }}s;
    --ticker-padding: {{ section.settings.padding_y }}px;
  "
>
  <div class="ticker-track">
    <div class="ticker-content">
      {%- for i in (1..3) -%}
        {%- for block in section.blocks -%}
          <div class="ticker-item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <span class="ticker-icon">
                {%- case block.settings.icon -%}
                  {%- when 'tag' -%}🏷️
                  {%- when 'truck' -%}🚚
                  {%- when 'star' -%}⭐
                  {%- when 'shield' -%}🛡️
                  {%- when 'fire' -%}🔥
                {%- endcase -%}
              </span>
            {%- endif -%}
            <span class="ticker-text">{{ block.settings.text }}</span>
            {%- if block.settings.link_text != blank and block.settings.link_url != blank -%}
              <a href="{{ block.settings.link_url }}" class="ticker-link">{{ block.settings.link_text }} →</a>
            {%- endif -%}
            <span class="ticker-separator">✦</span>
          </div>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  #shopify-section-ticker-{{ section.id }} {
    background-color: var(--ticker-bg);
    color: var(--ticker-text);
    padding: var(--ticker-padding) 0;
    overflow: hidden;
    white-space: nowrap;
    position: relative;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .ticker-track {
    display: flex;
    width: max-content;
  }
  .ticker-content {
    display: flex;
    align-items: center;
    animation: tickerLoop var(--ticker-speed) linear infinite;
  }
  .ticker-track:hover .ticker-content {
    animation-play-state: paused;
  }
  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0 1.25rem;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.015em;
  }
  .ticker-link {
    color: var(--ticker-highlight);
    text-decoration: underline;
    font-weight: 600;
    margin-left: 0.25rem;
  }
  .ticker-separator {
    margin-left: 1.25rem;
    color: var(--ticker-highlight);
    opacity: 0.7;
    font-size: 0.75rem;
  }
  @keyframes tickerLoop {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
</style>

{% schema %}
{
  "name": "Announcement Ticker",
  "tag": "section",
  "class": "section-ticker",
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Scroll Duration (Seconds)",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 25
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 6,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 10
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Highlight & Link Color",
      "default": "#FBBF24"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Free Shipping (Truck)" },
            { "value": "tag", "label": "Discount (Tag)" },
            { "value": "fire", "label": "Hot Deal (Fire)" },
            { "value": "shield", "label": "Guarantee (Shield)" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Free worldwide shipping on orders over $50"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link Text (Optional)",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Ticker",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "icon": "truck",
            "text": "FREE SHIPPING on all orders over $50",
            "link_text": "Claim Free Delivery",
            "link_url": "/collections/all"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "fire",
            "text": "SPRING FLASH SALE: Up to 40% OFF site-wide",
            "link_text": "View Deals",
            "link_url": "/collections/sale"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "icon": "shield",
            "text": "30-Day Hassle-Free Returns & 1-Year Full Warranty",
            "link_text": "Learn More",
            "link_url": "/pages/returns"
          }
        }
      ]
    }
  ]
}
{% endschema %}

