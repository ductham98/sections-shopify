<script>
  (() => {
    const root = document.getElementById('customimagehero-{{ section.id }}');

    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const hero = root.querySelector('[data-cih-hero]');
    const track = root.querySelector('[data-cih-track]');
    const slides = Array.from(root.querySelectorAll('[data-cih-slide]'));
    const thumbnails = Array.from(root.querySelectorAll('[data-cih-thumbnail]'));
    const dataElement = root.querySelector('[data-cih-slide-data]');

    if (!hero || !track || !slides.length || !dataElement) return;

    let slideData = [];

    try {
      slideData = JSON.parse(dataElement.textContent);
    } catch (error) {
      console.error('Custom Image Hero: Invalid slide data.', error);
      return;
    }

    const eyebrow = root.querySelector('[data-cih-eyebrow]');
    const heading = root.querySelector('[data-cih-heading]');
    const accent = root.querySelector('[data-cih-accent]');
    const description = root.querySelector('[data-cih-description]');

    const primary = root.querySelector('[data-cih-primary]');
    const primaryLabel = root.querySelector('[data-cih-primary-label]');
    const secondary = root.querySelector('[data-cih-secondary]');
    const secondaryLabel = root.querySelector('[data-cih-secondary-label]');

    const currentCounter = root.querySelector('[data-cih-current]');
    const previousButton = root.querySelector('[data-cih-prev]');
    const nextButton = root.querySelector('[data-cih-next]');

    const autoplay = root.dataset.autoplay === 'true';
    const interval = Math.max(2000, Number(root.dataset.interval) || 5000);
    const pauseOnHover = root.dataset.pauseHover === 'true';
    const enableDrag = {{ section.settings.enable_drag | json }};
    const total = slides.length;

    let activeIndex = 0;
    let timer = null;
    let isPointerDown = false;
    let isDragging = false;
    let startX = 0;
    let currentX = 0;
    let startTranslate = 0;
    let pointerId = null;

    const formatNumber = (number) => String(number).padStart(2, '0');

    const setText = (element, value) => {
      if (element) element.textContent = value || '';
    };

    const updateButton = (button, labelElement, label, link) => {
      if (!button || !labelElement) return;
      setText(labelElement, label);
      button.href = link || '#';
      button.hidden = !label;
    };

    const updateContent = (data) => {
      if (!data) return;

      setText(eyebrow, data.eyebrow);
      if (eyebrow) eyebrow.hidden = !data.eyebrow;

      setText(heading, data.heading);
      setText(accent, data.accent);
      if (accent) accent.hidden = !data.accent;

      if (description) {
        description.innerHTML = '';

        if (data.description) {
          data.description.split('\n').forEach((line, index) => {
            if (index > 0) description.appendChild(document.createElement('br'));
            description.appendChild(document.createTextNode(line));
          });
        }

        description.hidden = !data.description;
      }

      updateButton(primary, primaryLabel, data.primaryLabel, data.primaryLink);
      updateButton(secondary, secondaryLabel, data.secondaryLabel, data.secondaryLink);
    };

    const updatePosition = (animate = true) => {
      track.classList.toggle('is-dragging', !animate);
      track.style.transform = `translate3d(${-activeIndex * 100}%, 0, 0)`;
    };

    const stopAutoplay = () => {
      if (timer) {
        window.clearInterval(timer);
        timer = null;
      }
    };

    const startAutoplay = () => {
      stopAutoplay();

      if (!autoplay || total < 2 || document.hidden) return;

      timer = window.setInterval(() => {
        if (!isPointerDown) {
          activateSlide((activeIndex + 1) % total);
        }
      }, interval);
    };

    const activateSlide = (index, options = {}) => {
      const nextIndex = Math.max(0, Math.min(total - 1, index));
      activeIndex = nextIndex;

      slides.forEach((slide, slideIndex) => {
        slide.setAttribute('aria-hidden', String(slideIndex !== nextIndex));
      });

      thumbnails.forEach((thumbnail, thumbnailIndex) => {
        const active = thumbnailIndex === nextIndex;
        thumbnail.classList.toggle('is-active', active);
        thumbnail.setAttribute('aria-pressed', String(active));
      });

      if (currentCounter) currentCounter.textContent = formatNumber(nextIndex + 1);

      updateContent(slideData[nextIndex]);
      updatePosition(options.animate !== false);

      if (options.restartAutoplay !== false) startAutoplay();
    };

    const goNext = () => activateSlide((activeIndex + 1) % total);
    const goPrevious = () => activateSlide((activeIndex - 1 + total) % total);

    thumbnails.forEach((thumbnail, index) => {
      thumbnail.addEventListener('click', () => activateSlide(index));
    });

    if (previousButton) previousButton.addEventListener('click', goPrevious);
    if (nextButton) nextButton.addEventListener('click', goNext);

    /* Pointer drag / touch swipe */

    if (enableDrag && total > 1) {
      const getTranslateX = () => {
        const matrix = new DOMMatrixReadOnly(window.getComputedStyle(track).transform);
        return matrix.m41;
      };

      hero.addEventListener('pointerdown', (event) => {
        if (event.target.closest('button, a')) return;
        if (event.pointerType === 'mouse' && event.button !== 0) return;

        isPointerDown = true;
        isDragging = false;
        pointerId = event.pointerId;
        startX = event.clientX;
        currentX = startX;
        startTranslate = getTranslateX();

        track.classList.add('is-dragging');
        hero.classList.add('is-dragging');
        stopAutoplay();

        try {
          hero.setPointerCapture(pointerId);
        } catch (error) {}
      });

      hero.addEventListener('pointermove', (event) => {
        if (!isPointerDown || event.pointerId !== pointerId) return;

        currentX = event.clientX;
        const deltaX = currentX - startX;

        if (Math.abs(deltaX) > 5) isDragging = true;

        if (isDragging) {
          const width = hero.getBoundingClientRect().width;
          const minTranslate = -(total - 1) * width;
          const nextTranslate = Math.min(0, Math.max(minTranslate, startTranslate + deltaX));

          track.style.transform = `translate3d(${nextTranslate}px, 0, 0)`;
        }
      });

      const finishDrag = (event) => {
        if (!isPointerDown || event.pointerId !== pointerId) return;

        const deltaX = currentX - startX;
        const threshold = Math.max(40, hero.clientWidth * 0.12);

        isPointerDown = false;
        track.classList.remove('is-dragging');
        hero.classList.remove('is-dragging');

        if (isDragging && Math.abs(deltaX) > threshold) {
          if (deltaX < 0) goNext();
          else goPrevious();
        } else {
          activateSlide(activeIndex);
        }

        isDragging = false;
        pointerId = null;
        startAutoplay();
      };

      hero.addEventListener('pointerup', finishDrag);
      hero.addEventListener('pointercancel', finishDrag);
      hero.addEventListener('lostpointercapture', () => {
        if (!isPointerDown) return;
        isPointerDown = false;
        isDragging = false;
        track.classList.remove('is-dragging');
        hero.classList.remove('is-dragging');
        activateSlide(activeIndex);
        startAutoplay();
      });

      hero.addEventListener('click', (event) => {
        if (isDragging) {
          event.preventDefault();
          event.stopPropagation();
        }
      }, true);
    }

    if (pauseOnHover) {
      hero.addEventListener('mouseenter', stopAutoplay);
      hero.addEventListener('mouseleave', startAutoplay);
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    document.addEventListener('shopify:block:select', (event) => {
      const selectedBlock = event.target.closest('[data-cih-slide]');
      if (!selectedBlock || !root.contains(selectedBlock)) return;

      const index = slides.indexOf(selectedBlock);
      if (index !== -1) {
        stopAutoplay();
        activateSlide(index);
      }
    });

    activateSlide(0);
    startAutoplay();

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target.contains(root)) {
        stopAutoplay();
        root.dataset.initialized = 'false';
      }
    });
  })();
</script>

