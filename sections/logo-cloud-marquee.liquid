{%- liquid
  assign bg_color = section.settings.bg_color | default: '#ffffff'
  assign text_color = section.settings.text_color | default: '#111827'
  assign speed = section.settings.speed | default: 28
-%}

<section
  id="shopify-section-logos-{{ section.id }}"
  class="logo-cloud-section"
  style="
    --lc-bg: {{ bg_color }};
    --lc-text: {{ text_color }};
    --lc-speed: {{ speed }}s;
    --lc-padding: {{ section.settings.padding_y }}px;
  "
>
  <div class="logo-cloud-container">
    {%- if section.settings.heading != blank -%}
      <p class="logo-cloud-title">{{ section.settings.heading }}</p>
    {%- endif -%}

    <div class="logo-marquee-wrapper">
      <div class="logo-track">
        {%- for i in (1..2) -%}
          <div class="logo-group">
            {%- for block in section.blocks -%}
              <div class="logo-item" {{ block.shopify_attributes }}>
                {%- if block.settings.logo != blank -%}
                  {{ block.settings.logo | image_url: width: 240 | image_tag: class: 'logo-img', loading: 'lazy' }}
                {%- else -%}
                  <span class="logo-text-placeholder">{{ block.settings.title | default: 'BRAND LOGO' }}</span>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<style>
  #shopify-section-logos-{{ section.id }} {
    background-color: var(--lc-bg);
    color: var(--lc-text);
    padding: var(--lc-padding) 0;
    overflow: hidden;
  }
  .logo-cloud-container {
    width: 100%;
    margin: 0 auto;
    text-align: center;
  }
  .logo-cloud-title {
    font-size: 0.875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #9ca3af;
    margin: 0 0 1.75rem;
    padding: 0 1rem;
  }
  .logo-marquee-wrapper {
    overflow: hidden;
    position: relative;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }
  .logo-track {
    display: flex;
    width: max-content;
  }
  .logo-group {
    display: flex;
    align-items: center;
    gap: 4rem;
    padding-right: 4rem;
    animation: marqueeRoll var(--lc-speed) linear infinite;
  }
  .logo-marquee-wrapper:hover .logo-group {
    animation-play-state: paused;
  }
  .logo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.65;
    filter: grayscale(100%);
    transition: opacity 0.2s, filter 0.2s;
  }
  .logo-item:hover {
    opacity: 1;
    filter: grayscale(0%);
  }
  .logo-img {
    height: 38px;
    width: auto;
    object-fit: contain;
  }
  .logo-text-placeholder {
    font-size: 1.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    color: #4b5563;
  }
  @keyframes marqueeRoll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-100%); }
  }
</style>

{% schema %}
{
  "name": "Logo Cloud Marquee",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "TRUSTED BY LEADING BRANDS AROUND THE GLOBE"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Animation Duration (Seconds)",
      "min": 15,
      "max": 60,
      "step": 5,
      "default": 30
    },
    {
      "type": "range",
      "id": "padding_y",
      "label": "Vertical Padding",
      "min": 24,
      "max": 100,
      "step": 8,
      "unit": "px",
      "default": 48
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111827"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Brand Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Brand Name (Fallback)",
          "default": "BrandName"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo Cloud Marquee",
      "blocks": [
        { "type": "logo", "settings": { "title": "Forbes" } },
        { "type": "logo", "settings": { "title": "TechCrunch" } },
        { "type": "logo", "settings": { "title": "Vogue" } },
        { "type": "logo", "settings": { "title": "Wired" } },
        { "type": "logo", "settings": { "title": "GQ" } },
        { "type": "logo", "settings": { "title": "Bloomberg" } }
      ]
    }
  ]
}
{% endschema %}

