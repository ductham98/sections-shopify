      min-height: {{ section.settings.mobile_quick_add_height }}px;
      padding: 8px;
      font-size: {{ section.settings.mobile_quick_add_font_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__details {
      padding-top: {{ section.settings.mobile_details_padding_top }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__vendor {
      margin-bottom: 5px;
      font-size: {{ section.settings.mobile_vendor_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__product-title {
      font-size: {{ section.settings.mobile_product_title_size }}px;
      line-height: 1.35;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__rating {
      gap: 4px;
      margin-top: 5px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__stars {
      font-size: {{ section.settings.mobile_star_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__rating-text {
      font-size: {{ section.settings.mobile_rating_text_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__price {
      gap: 5px;
      margin-top: {{ section.settings.mobile_price_spacing }}px;
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__price-compare {
      font-size: {{ section.settings.mobile_compare_price_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__from {
      font-size: {{ section.settings.mobile_price_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__view-link {
      gap: 5px;
      margin-top: 8px;
      font-size: {{ section.settings.mobile_view_link_size }}px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__view-link svg {
      width: 14px;
      height: 14px;
      flex-basis: 14px;
    }

    #velroxa-featured-products-{{ section.id }} .vfp__footer {
