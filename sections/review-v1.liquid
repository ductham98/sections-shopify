<script>
  (() => {
    const root = document.getElementById({{ section_id | json }});
    if (!root || root.dataset.rtInitialized === 'true') return;

    root.dataset.rtInitialized = 'true';

    const carousel = root.querySelector('[data-rt-carousel]');
    const viewport = root.querySelector('[data-rt-viewport]');
    const track = root.querySelector('[data-rt-track]');
    const prev = root.querySelector('[data-rt-prev]');
    const next = root.querySelector('[data-rt-next]');
    const dotsContainer = root.querySelector('[data-rt-dots]');

    if (!carousel || !viewport || !track) return;

    const enabled = carousel.dataset.enabled === 'true';
    const cards = Array.from(track.querySelectorAll('.rt-card'));

    if (!enabled || cards.length < 2) {
      if (prev) prev.hidden = true;
      if (next) next.hidden = true;
      if (dotsContainer) dotsContainer.hidden = true;
      return;
    }

    let index = 0;
    let perView = 1;
    let maxIndex = 0;
    let resizeTimer;

    const getPerView = () => {
      if (window.innerWidth <= 749) {
        return Number(getComputedStyle(root).getPropertyValue('--rt-mobile-columns')) || 1;
      }

      if (window.innerWidth <= 989) {
        return Number(getComputedStyle(root).getPropertyValue('--rt-tablet-columns')) || 2;
      }

      return Number(getComputedStyle(root).getPropertyValue('--rt-desktop-columns')) || 3;
    };

    const getGap = () => {
      return parseFloat(getComputedStyle(track).columnGap || getComputedStyle(track).gap) || 0;
    };

    const renderDots = () => {
      if (!dotsContainer) return;

      dotsContainer.innerHTML = '';

      for (let i = 0; i <= maxIndex; i++) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'rt-dot' + (i === index ? ' is-active' : '');
        dot.setAttribute('aria-label', 'Go to review slide ' + (i + 1));

        dot.addEventListener('click', () => {
          index = i;
          update();
        });

        dotsContainer.appendChild(dot);
      }
    };

    const update = () => {
      perView = getPerView();
      maxIndex = Math.max(0, cards.length - perView);
      index = Math.min(index, maxIndex);

      const cardWidth = cards[0].getBoundingClientRect().width;
      const offset = index * (cardWidth + getGap());

      track.style.transform = `translate3d(-${offset}px, 0, 0)`;

      if (prev) prev.disabled = index <= 0;
      if (next) next.disabled = index >= maxIndex;

      if (dotsContainer) {
        Array.from(dotsContainer.children).forEach((dot, i) => {
          dot.classList.toggle('is-active', i === index);
        });
      }
    };

    if (prev) {
      prev.addEventListener('click', () => {
        index = Math.max(0, index - 1);
        update();
      });
    }

    if (next) {
      next.addEventListener('click', () => {
        index = Math.min(maxIndex, index + 1);
        update();
      });
    }

    let touchStartX = 0;

    viewport.addEventListener('touchstart', (event) => {
      touchStartX = event.touches[0].clientX;
    }, { passive: true });

    viewport.addEventListener('touchend', (event) => {
      const difference = touchStartX - event.changedTouches[0].clientX;

      if (Math.abs(difference) < 40) return;

      if (difference > 0) {
        index = Math.min(maxIndex, index + 1);
      } else {
        index = Math.max(0, index - 1);
      }

      update();
    }, { passive: true });

    renderDots();
    update();

    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        renderDots();
        update();
      }, 120);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target && event.target.contains(root)) {
        root.dataset.rtInitialized = 'false';
      }
    });
  })();
</script>

