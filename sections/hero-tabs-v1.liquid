{% liquid
  assign section_id = 'customherotabs-' | append: section.id
  assign heading_tag = section.settings.heading_tag
  assign section_width_mode = section.settings.section_width_mode

  case section_width_mode
    when 'full'
      assign section_width_value = 'none'
    when 'container'
      assign section_width_value = 'var(--page-width, 1200px)'
    else
      assign section_width_value = section.settings.custom_width | append: 'px'
  endcase
%}

<section
  id="{{ section_id }}"
  class="customherotabs"
  data-section-id="{{ section.id }}"
  style="
    --cht-background: {{ section.settings.background_color }};
    --cht-text: {{ section.settings.text_color }};
    --cht-muted: {{ section.settings.description_color }};
    --cht-accent: {{ section.settings.accent_color }};
    --cht-button-bg: {{ section.settings.button_background }};
    --cht-button-text: {{ section.settings.button_text_color }};
    --cht-container-width: {{ section_width_value }};
    --cht-height: {{ section.settings.hero_height }}px;
    --cht-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  "
>
  <div class="cht__container">
    <div class="cht__hero" data-cht-hero>
      {% for block in section.blocks %}
        <div
          class="cht__slide{% if forloop.first %} is-active{% endif %}"
          data-cht-slide
          data-index="{{ forloop.index0 }}"
          aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
          {{ block.shopify_attributes }}
        >
          <div class="cht__image-wrap">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 2400
                | image_tag:
                  class: 'cht__image',
                  widths: '750, 1000, 1400, 1800, 2200, 2400',
                  sizes: '100vw',
                  loading: 'lazy',
                  alt: block.settings.image.alt
              }}
            {% else %}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'cht__placeholder' }}
            {% endif %}
          </div>

          <div class="cht__slide-overlay"></div>
        </div>
      {% endfor %}

      <div class="cht__content">
        <div class="cht__content-inner" data-cht-content>
          {% if section.blocks.size > 0 %}
            {% assign first_block = section.blocks.first %}

            {% if section.settings.show_eyebrow and first_block.settings.eyebrow != blank %}
              <p class="cht__eyebrow" data-cht-eyebrow>
                {{ first_block.settings.eyebrow | escape }}
              </p>
            {% else %}
              <p class="cht__eyebrow" data-cht-eyebrow hidden></p>
            {% endif %}

            <{{ heading_tag }} class="cht__heading" data-cht-heading>
              {{ first_block.settings.heading | escape }}
            </{{ heading_tag }}>

            {% if first_block.settings.description != blank %}
              <div class="cht__description" data-cht-description>
                {{ first_block.settings.description | escape | newline_to_br }}
              </div>
            {% else %}
              <div class="cht__description" data-cht-description hidden></div>
            {% endif %}

            <a
              class="cht__button"
              data-cht-button
              href="{{ first_block.settings.button_link | default: '#' }}"
              {% if first_block.settings.button_link == blank %}
                hidden
              {% endif %}
            >
              <span data-cht-button-label>
                {{ first_block.settings.button_label | escape }}
              </span>
              {% if section.settings.show_button_arrow %}
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path
                    d="M3.5 10h12m-5-5 5 5-5 5"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              {% endif %}
            </a>
          {% endif %}
        </div>
      </div>

      {% if section.settings.show_tabs and section.blocks.size > 0 %}
        <div class="cht__tabs" role="tablist" aria-label="{{ section.settings.tabs_aria_label | escape }}">
          {% for block in section.blocks %}
            <button
              class="cht__tab{% if forloop.first %} is-active{% endif %}"
              type="button"
              role="tab"
              data-cht-tab
              data-index="{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="cht-slide-{{ section.id }}-{{ forloop.index }}"
              id="cht-tab-{{ section.id }}-{{ forloop.index }}"
            >
              <span class="cht__tab-line"></span>
              <span class="cht__tab-number">
                {% if section.settings.show_tab_numbers %}
                  {{ forloop.index | prepend: '0' }}
                {% endif %}
              </span>
              <span class="cht__tab-label">
                {{ block.settings.tab_label | default: block.settings.heading | escape }}
              </span>
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size == 0 %}
      <div class="cht__empty">Add slide blocks to display the hero banner.</div>
    {% endif %}
  </div>

  <script type="application/json" data-cht-slide-data>
    [
      {% for block in section.blocks %}
        {
          "eyebrow": {{ block.settings.eyebrow | json }},
          "heading": {{ block.settings.heading | json }},
          "description": {{ block.settings.description | json }},
          "buttonLabel": {{ block.settings.button_label | json }},
          "buttonLink": {{ block.settings.button_link | default: '#' | json }},
          "hasButton": {% if block.settings.button_label != blank and block.settings.button_link != blank %}true{% else %}false{% endif %},
          "tabLabel": {{ block.settings.tab_label | default: block.settings.heading | json }}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  </script>
</section>

<style>
  #customherotabs-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--cht-background);
    font-family: {{ section.settings.body_font }};
  }

  #customherotabs-{{ section.id }} *,
  #customherotabs-{{ section.id }} *::before,
  #customherotabs-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #customherotabs-{{ section.id }} .cht__container {
    width: 100%;
    max-width: var(--cht-container-width);
    margin: 0 auto;
    padding: 0 {{ section.settings.container_padding }}px;
  }

  #customherotabs-{{ section.id }} .cht__hero {
    position: relative;
    width: 100%;
    height: var(--cht-height);
    min-height: 420px;
    overflow: hidden;
    background: #25251e;
    color: var(--cht-text);
    isolation: isolate;
  }

  /* Background slides */

  #customherotabs-{{ section.id }} .cht__slide {
    position: absolute;
    z-index: 0;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity 650ms ease,
      visibility 650ms ease;
  }

  #customherotabs-{{ section.id }} .cht__slide.is-active {
    visibility: visible;
    opacity: 1;
  }

  #customherotabs-{{ section.id }} .cht__image-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #customherotabs-{{ section.id }} .cht__image,
  #customherotabs-{{ section.id }} .cht__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.image_position }};
  }

  #customherotabs-{{ section.id }} .cht__slide-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(0, 0, 0, var(--cht-overlay-opacity)) 0%,
        rgba(0, 0, 0, calc(var(--cht-overlay-opacity) * 0.8)) 27%,
        rgba(0, 0, 0, calc(var(--cht-overlay-opacity) * 0.35)) 58%,
        rgba(0, 0, 0, 0.08) 100%
      ),
      linear-gradient(
        0deg,
        rgba(0, 0, 0, 0.65) 0%,
        rgba(0, 0, 0, 0) 43%
      );
  }

  /* Main content */

  #customherotabs-{{ section.id }} .cht__content {
    position: absolute;
    z-index: 2;
    top: {{ section.settings.content_top }}%;
    left: {{ section.settings.content_left }}%;
    width: {{ section.settings.content_width }}%;
    max-width: {{ section.settings.content_max_width }}px;
    transform: translateY(-{{ section.settings.content_vertical_offset }}%);
  }

  #customherotabs-{{ section.id }} .cht__content-inner {
    width: 100%;
    animation: chtContentIn-{{ section.id }} 500ms ease both;
  }

  @keyframes chtContentIn-{{ section.id }} {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #customherotabs-{{ section.id }} .cht__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    line-height: 1.5;
    text-transform: uppercase;
  }

  #customherotabs-{{ section.id }} .cht__heading {
    margin: 0;
    color: var(--cht-text);
    font-family: {{ section.settings.heading_font }};
    font-size: {{ section.settings.heading_size }}px;
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: {{ section.settings.heading_line_height }};
    text-transform: {{ section.settings.heading_transform }};
  }

  #customherotabs-{{ section.id }} .cht__description {
    max-width: {{ section.settings.description_width }}px;
    margin-top: {{ section.settings.description_spacing }}px;
    color: var(--cht-muted);
    font-size: {{ section.settings.description_size }}px;
    font-weight: {{ section.settings.description_weight }};
    line-height: {{ section.settings.description_line_height }};
  }

  /* CTA */

  #customherotabs-{{ section.id }} .cht__button {
    display: inline-flex;
    min-height: {{ section.settings.button_height }}px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: {{ section.settings.button_spacing }}px;
    padding: 10px {{ section.settings.button_padding }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_radius }}px;
    background: var(--cht-button-bg);
    color: var(--cht-button-text);
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_weight }};
    letter-spacing: {{ section.settings.button_letter_spacing }}px;
    line-height: 1.3;
    text-decoration: none;
    text-transform: {{ section.settings.button_transform }};
    transition:
      background 200ms ease,
      color 200ms ease,
      transform 200ms ease;
  }

  #customherotabs-{{ section.id }} .cht__button:hover {
    background: {{ section.settings.button_hover_background }};
    color: {{ section.settings.button_hover_text }};
    transform: translateY(-2px);
  }

  #customherotabs-{{ section.id }} .cht__button:focus-visible {
    outline: 2px solid var(--cht-accent);
    outline-offset: 4px;
  }

  #customherotabs-{{ section.id }} .cht__button svg {
    width: 16px;
    height: 16px;
    flex: 0 0 16px;
  }

  /* Bottom tabs */

  #customherotabs-{{ section.id }} .cht__tabs {
    position: absolute;
    z-index: 3;
    right: {{ section.settings.tabs_horizontal_padding }}px;
    bottom: {{ section.settings.tabs_bottom }}px;
    left: {{ section.settings.tabs_horizontal_padding }}px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: {{ section.settings.tabs_gap }}px;
  }

  #customherotabs-{{ section.id }} .cht__tab {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: flex-start;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--cht-text);
    text-align: left;
    cursor: pointer;
    appearance: none;
  }

  #customherotabs-{{ section.id }} .cht__tab-line {
    display: block;
    width: 100%;
    height: {{ section.settings.tab_line_height }}px;
    margin-bottom: {{ section.settings.tab_line_spacing }}px;
    background: {{ section.settings.tab_line_color }};
    opacity: {{ section.settings.tab_line_opacity | divided_by: 100.0 }};
    transition:
      background 250ms ease,
      opacity 250ms ease;
  }

  #customherotabs-{{ section.id }} .cht__tab.is-active .cht__tab-line {
    background: var(--cht-text);
    opacity: 1;
  }

  #customherotabs-{{ section.id }} .cht__tab-number {
    min-height: 15px;
    margin-bottom: 3px;
    color: {{ section.settings.tab_number_color }};
    font-size: {{ section.settings.tab_number_size }}px;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.3;
  }

  #customherotabs-{{ section.id }} .cht__tab-label {
    color: {{ section.settings.tab_label_color }};
    font-size: {{ section.settings.tab_label_size }}px;
    font-weight: {{ section.settings.tab_label_weight }};
    line-height: 1.4;
    transition: color 200ms ease;
  }

  #customherotabs-{{ section.id }} .cht__tab.is-active .cht__tab-label {
    color: var(--cht-text);
  }

  #customherotabs-{{ section.id }} .cht__tab:focus-visible {
    outline: 2px solid var(--cht-accent);
    outline-offset: 5px;
  }

  #customherotabs-{{ section.id }} .cht__empty {
    padding: 50px 20px;
    border: 1px dashed #aaa;
    color: #777;
    text-align: center;
  }

  #customherotabs-{{ section.id }} [hidden] {
    display: none !important;
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    #customherotabs-{{ section.id }} .cht__container {
      padding-right: {{ section.settings.tablet_container_padding }}px;
      padding-left: {{ section.settings.tablet_container_padding }}px;
    }

    #customherotabs-{{ section.id }} .cht__hero {
      height: {{ section.settings.tablet_hero_height }}px;
    }

    #customherotabs-{{ section.id }} .cht__heading {
      font-size: {{ section.settings.tablet_heading_size }}px;
    }

    #customherotabs-{{ section.id }} .cht__content {
      left: {{ section.settings.tablet_content_left }}%;
      width: {{ section.settings.tablet_content_width }}%;
    }

    #customherotabs-{{ section.id }} .cht__tabs {
      right: {{ section.settings.tablet_tabs_padding }}px;
      left: {{ section.settings.tablet_tabs_padding }}px;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #customherotabs-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #customherotabs-{{ section.id }} .cht__container {
      padding-right: {{ section.settings.mobile_container_padding }}px;
      padding-left: {{ section.settings.mobile_container_padding }}px;
    }

    #customherotabs-{{ section.id }} .cht__hero {
      height: {{ section.settings.mobile_hero_height }}px;
      min-height: 480px;
    }

    #customherotabs-{{ section.id }} .cht__slide-overlay {
      background:
        linear-gradient(
          90deg,
          rgba(0, 0, 0, calc(var(--cht-overlay-opacity) * 0.85)) 0%,
          rgba(0, 0, 0, calc(var(--cht-overlay-opacity) * 0.2)) 100%
        ),
        linear-gradient(
          0deg,
          rgba(0, 0, 0, 0.85) 0%,
          rgba(0, 0, 0, 0.05) 75%
        );
    }

    #customherotabs-{{ section.id }} .cht__content {
      top: {{ section.settings.mobile_content_top }}%;
      left: {{ section.settings.mobile_content_left }}%;
      width: {{ section.settings.mobile_content_width }}%;
      max-width: none;
      transform: none;
    }

    #customherotabs-{{ section.id }} .cht__eyebrow {
      margin-bottom: 14px;
      font-size: {{ section.settings.mobile_eyebrow_size }}px;
    }

    #customherotabs-{{ section.id }} .cht__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.08;
    }

    #customherotabs-{{ section.id }} .cht__description {
      margin-top: 14px;
      font-size: {{ section.settings.mobile_description_size }}px;
      line-height: 1.55;
    }

    #customherotabs-{{ section.id }} .cht__button {
      min-height: {{ section.settings.mobile_button_height }}px;
      margin-top: 22px;
      padding: 10px 22px;
      font-size: {{ section.settings.mobile_button_font_size }}px;
    }

    #customherotabs-{{ section.id }} .cht__tabs {
      right: {{ section.settings.mobile_tabs_padding }}px;
      bottom: {{ section.settings.mobile_tabs_bottom }}px;
      left: {{ section.settings.mobile_tabs_padding }}px;
      gap: {{ section.settings.mobile_tabs_gap }}px;
    }

    #customherotabs-{{ section.id }} .cht__tab-line {
      margin-bottom: 8px;
    }

    #customherotabs-{{ section.id }} .cht__tab-number {
      font-size: 9px;
    }

    #customherotabs-{{ section.id }} .cht__tab-label {
      font-size: {{ section.settings.mobile_tab_label_size }}px;
      overflow-wrap: anywhere;
    }
  }

  @media screen and (max-width: 380px) {
    #customherotabs-{{ section.id }} .cht__tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
    }

    #customherotabs-{{ section.id }} .cht__tab-label {
      font-size: 11px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #customherotabs-{{ section.id }} *,
    #customherotabs-{{ section.id }} *::before,
    #customherotabs-{{ section.id }} *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('customherotabs-{{ section.id }}');

    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const slides = Array.from(root.querySelectorAll('[data-cht-slide]'));
    const tabs = Array.from(root.querySelectorAll('[data-cht-tab]'));
    const content = root.querySelector('[data-cht-content]');
    const dataElement = root.querySelector('[data-cht-slide-data]');

    if (!slides.length || !content || !dataElement) return;

    let slideData = [];

    try {
      slideData = JSON.parse(dataElement.textContent);
    } catch (error) {
      console.error('Custom Hero Tabs: Invalid slide data.', error);
      return;
    }

    const eyebrow = content.querySelector('[data-cht-eyebrow]');
    const heading = content.querySelector('[data-cht-heading]');
    const description = content.querySelector('[data-cht-description]');
    const button = content.querySelector('[data-cht-button]');
    const buttonLabel = content.querySelector('[data-cht-button-label]');

    let activeIndex = 0;

    const updateContent = (data) => {
      if (!data) return;

      if (eyebrow) {
        eyebrow.textContent = data.eyebrow || '';
        eyebrow.hidden = !data.eyebrow || !{{ section.settings.show_eyebrow | json }};
      }

      if (heading) {
        heading.textContent = data.heading || '';
      }

      if (description) {
        description.innerHTML = '';

        if (data.description) {
          data.description.split('\n').forEach((line, index) => {
            if (index > 0) description.appendChild(document.createElement('br'));
            description.appendChild(document.createTextNode(line));
          });
        }

        description.hidden = !data.description;
      }

      if (button && buttonLabel) {
        buttonLabel.textContent = data.buttonLabel || '';
        button.href = data.buttonLink || '#';
        button.hidden = !data.hasButton;
      }
    };

    const activateSlide = (index, moveFocus = false) => {
      if (index < 0 || index >= slides.length) return;

      activeIndex = index;

      slides.forEach((slide, slideIndex) => {
        const isActive = slideIndex === index;

        slide.classList.toggle('is-active', isActive);
        slide.setAttribute('aria-hidden', String(!isActive));
      });

      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === index;

        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;

        if (moveFocus && isActive) {
          tab.focus();
        }
      });

      updateContent(slideData[index]);
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        activateSlide(index);
      });

      tab.addEventListener('keydown', (event) => {
        let nextIndex = activeIndex;

        if (event.key === 'ArrowRight') {
          nextIndex = (activeIndex + 1) % tabs.length;
        } else if (event.key === 'ArrowLeft') {
          nextIndex = (activeIndex - 1 + tabs.length) % tabs.length;
        } else if (event.key === 'Home') {
          nextIndex = 0;
        } else if (event.key === 'End') {
          nextIndex = tabs.length - 1;
        } else {
          return;
        }

        event.preventDefault();
        activateSlide(nextIndex, true);
      });
    });

    activateSlide(0);

    document.addEventListener('shopify:block:select', (event) => {
      const selectedBlock = event.target.closest('[data-cht-slide]');

      if (!selectedBlock || !root.contains(selectedBlock)) return;

      const index = slides.indexOf(selectedBlock);

      if (index !== -1) activateSlide(index);
    });

    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target.contains(root)) {
        root.dataset.initialized = 'false';
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Custom Hero Tabs",
  "tag": "section",
  "class": "section-custom-hero-tabs",
  "max_blocks": 3,
  "settings": [
    {
      "type": "header",
      "content": "General"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading HTML tag",
      "options": [
        { "value": "h1", "label": "H1" },
        { "value": "h2", "label": "H2" },
        { "value": "h3", "label": "H3" }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tabs",
      "label": "Show bottom tabs",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_tab_numbers",
      "label": "Show tab numbers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_button_arrow",
      "label": "Show button arrow",
      "default": false
    },
    {
      "type": "text",
      "id": "tabs_aria_label",
      "label": "Tabs accessibility label",
      "default": "Explore categories"
    },
    {
      "type": "header",
      "content": "Desktop layout"
    },
    {
      "type": "select",
      "id": "section_width_mode",
      "label": "Section width",
      "options": [
        { "value": "custom", "label": "Custom" },
        { "value": "full", "label": "Full width" },
        { "value": "container", "label": "Container" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Custom width",
      "min": 1000,
      "max": 1800,
      "step": 50,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "container_padding",
      "label": "Container padding",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
