{% liquid
  assign section_id = 'customclubnewsletter-' | append: section.id
  assign form_id = 'ClubNewsletterForm-' | append: section.id
  assign benefit_count = section.blocks.size
  assign heading_tag = section.settings.heading_tag
%}

<section
  id="{{ section_id }}"
  class="customclubnewsletter"
  data-section-id="{{ section.id }}"
  style="
    --ccn-bg: {{ section.settings.background_color }};
    --ccn-heading: {{ section.settings.heading_color }};
    --ccn-highlight: {{ section.settings.highlight_color }};
    --ccn-description: {{ section.settings.description_color }};
    --ccn-text: {{ section.settings.benefit_title_color }};
    --ccn-muted: {{ section.settings.benefit_description_color }};
    --ccn-accent: {{ section.settings.accent_color }};
    --ccn-icon-bg: {{ section.settings.icon_background }};
    --ccn-form-bg: {{ section.settings.form_background }};
    --ccn-form-border: {{ section.settings.form_border_color }};
    --ccn-input-text: {{ section.settings.input_text_color }};
    --ccn-placeholder: {{ section.settings.placeholder_color }};
    --ccn-button-bg: {{ section.settings.button_background }};
    --ccn-button-text: {{ section.settings.button_text_color }};
    --ccn-button-hover-bg: {{ section.settings.button_hover_background }};
    --ccn-button-hover-text: {{ section.settings.button_hover_text }};
    --ccn-container-width: {{ section.settings.container_width }}px;
    --ccn-content-width: {{ section.settings.content_width }}px;
    --ccn-heading-size: {{ section.settings.heading_size }}px;
    --ccn-form-radius: {{ section.settings.form_radius }}px;
    --ccn-button-radius: {{ section.settings.button_radius }}px;
  "
>
  <div class="ccn__container">
    <div class="ccn__content">
      {% if section.settings.show_eyebrow and section.settings.eyebrow != blank %}
        <p class="ccn__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </p>
      {% endif %}

      {% if section.settings.show_heading %}
        <{{ heading_tag }} class="ccn__heading">
          {% if section.settings.heading_before != blank %}
            <span class="ccn__heading-before">
              {{ section.settings.heading_before | escape }}
            </span>
          {% endif %}
          {% if section.settings.heading_highlight != blank %}
            <span class="ccn__heading-highlight">
              {{ section.settings.heading_highlight | escape }}
            </span>
          {% endif %}
        </{{ heading_tag }}>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="ccn__description">
          {{ section.settings.description | escape | newline_to_br }}
        </div>
      {% endif %}

      {% if section.settings.show_form %}
        <div class="ccn__form-wrapper">
          {% form 'customer', id: form_id, class: 'ccn__form' %}
            <input type="hidden" name="contact[tags]" value="newsletter, club-member">

            {% if form.posted_successfully? %}
              <div class="ccn__message ccn__message--success" role="status" tabindex="-1">
                <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                  <path d="m4 10 4 4 8-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>{{ section.settings.success_message | escape }}</span>
              </div>
            {% else %}
              {% if form.errors %}
                <div class="ccn__message ccn__message--error" role="alert">
                  {{ form.errors.translated_fields.email | capitalize }}
                  {{ form.errors.messages.email }}
                </div>
              {% endif %}

              <div class="ccn__form-fields">
                <div class="ccn__input-wrapper">
                  <label class="ccn__visually-hidden" for="ClubEmail-{{ section.id }}">
                    {{ section.settings.email_label | escape }}
                  </label>

                  <input
                    id="ClubEmail-{{ section.id }}"
                    class="ccn__input"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ section.settings.email_placeholder | escape }}"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    required
                    {% if form.errors %}
                      aria-invalid="true"
                    {% endif %}
                  >
                </div>

                <button class="ccn__button" type="submit" name="commit">
                  <span>{{ section.settings.button_label | escape }}</span>
                  {% if section.settings.show_button_icon %}
                    <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
                      <path d="M3.5 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  {% endif %}
                </button>
              </div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}

      {% if section.settings.show_divider and benefit_count > 0 %}
        <div class="ccn__divider" aria-hidden="true"></div>
      {% endif %}

      {% if benefit_count > 0 and section.settings.show_benefits %}
        <div class="ccn__benefits">
          {% for block in section.blocks %}
            <div class="ccn__benefit" {{ block.shopify_attributes }}>
              {% if block.settings.show_icon %}
                <div class="ccn__benefit-icon">
                  {% case block.settings.icon %}
                    {% when 'gift' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3.5" y="9" width="17" height="11" rx="1.5" stroke="currentColor" stroke-width="1.7"/>
                        <path d="M12 9v11M3.5 13h17M12 9H7.8a2.3 2.3 0 1 1 2.3-2.3V9Zm0 0h4.2a2.3 2.3 0 1 0-2.3-2.3V9Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% when 'lightning' %}
                      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M13.1 2.8 5.4 13.2c-.3.4 0 1 .5 1h5l-.9 7c-.1.6.7.9 1 .4l7.6-11c.3-.4 0-1-.5-1h-5l1-6c.1-.6-.7-.9-1-.4Z"/>
                      </svg>
                    {% when 'location' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M19 10.2c0 5.2-7 11-7 11s-7-5.8-7-11a7 7 0 1 1 14 0Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                        <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.7"/>
                      </svg>
                    {% when 'star' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="m12 3 2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9L12 3Z" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% when 'heart' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M20.8 8.8c0 5.2-8.8 11-8.8 11s-8.8-5.8-8.8-11A4.8 4.8 0 0 1 12 6.1a4.8 4.8 0 0 1 8.8 2.7Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                      </svg>
                    {% when 'truck' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M3 6h11v11H3zM14 10h4l3 3v4h-7z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
                        <circle cx="7.5" cy="18" r="2" stroke="currentColor" stroke-width="1.7"/>
                        <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.7"/>
                      </svg>
                    {% when 'check' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/>
                        <path d="m8 12 2.5 2.5L16 9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    {% when 'mail' %}
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.7"/>
                        <path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                  {% endcase %}
                </div>
              {% endif %}

              {% if block.settings.title != blank %}
                <h3 class="ccn__benefit-title">
                  {{ block.settings.title | escape }}
                </h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <p class="ccn__benefit-description">
                  {{ block.settings.description | escape }}
                </p>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% endif %}

      {% if section.settings.show_bottom_note and section.settings.bottom_note != blank %}
        <div class="ccn__bottom-note">
          {{ section.settings.bottom_note | escape }}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  #customclubnewsletter-{{ section.id }} {
    width: 100%;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: var(--ccn-bg);
    color: var(--ccn-heading);
    font-family: {{ section.settings.body_font }};
  }

  #customclubnewsletter-{{ section.id }} *,
  #customclubnewsletter-{{ section.id }} *::before,
  #customclubnewsletter-{{ section.id }} *::after {
    box-sizing: border-box;
  }

  #customclubnewsletter-{{ section.id }} .ccn__container {
    width: 100%;
    max-width: var(--ccn-container-width);
    margin: 0 auto;
    padding-right: {{ section.settings.container_padding }}px;
    padding-left: {{ section.settings.container_padding }}px;
  }

  #customclubnewsletter-{{ section.id }} .ccn__content {
    width: 100%;
    max-width: var(--ccn-content-width);
    margin: 0 auto;
    text-align: {{ section.settings.content_alignment }};
  }

  /* Heading */

  #customclubnewsletter-{{ section.id }} .ccn__eyebrow {
    margin: 0 0 {{ section.settings.eyebrow_spacing }}px;
    color: {{ section.settings.eyebrow_color }};
    font-size: {{ section.settings.eyebrow_size }}px;
    font-weight: {{ section.settings.eyebrow_weight }};
    letter-spacing: {{ section.settings.eyebrow_letter_spacing }}px;
    line-height: 1.4;
    text-transform: uppercase;
  }

  #customclubnewsletter-{{ section.id }} .ccn__heading {
    margin: 0;
    color: var(--ccn-heading);
    font-family: {{ section.settings.heading_font }};
    font-size: var(--ccn-heading-size);
    font-weight: {{ section.settings.heading_weight }};
    letter-spacing: {{ section.settings.heading_letter_spacing }}px;
    line-height: 1.15;
  }

  #customclubnewsletter-{{ section.id }} .ccn__heading-before {
    color: var(--ccn-heading);
  }

  #customclubnewsletter-{{ section.id }} .ccn__heading-highlight {
    color: var(--ccn-highlight);
  }

  #customclubnewsletter-{{ section.id }} .ccn__description {
    max-width: {{ section.settings.description_width }}px;
    margin: {{ section.settings.description_spacing }}px auto 0;
    color: var(--ccn-description);
    font-size: {{ section.settings.description_size }}px;
    font-weight: {{ section.settings.description_weight }};
    line-height: 1.65;
  }

  /* Newsletter form */

  #customclubnewsletter-{{ section.id }} .ccn__form-wrapper {
    width: 100%;
    max-width: {{ section.settings.form_width }}px;
    margin: {{ section.settings.form_spacing }}px auto 0;
  }

  #customclubnewsletter-{{ section.id }} .ccn__form {
    width: 100%;
    margin: 0;
  }

  #customclubnewsletter-{{ section.id }} .ccn__form-fields {
    display: flex;
    width: 100%;
    min-height: {{ section.settings.form_height }}px;
    align-items: center;
    gap: {{ section.settings.form_gap }}px;
    padding: {{ section.settings.form_inner_padding }}px;
    border: {{ section.settings.form_border_width }}px solid var(--ccn-form-border);
    border-radius: var(--ccn-form-radius);
    background: var(--ccn-form-bg);
    transition: border-color 180ms ease, box-shadow 180ms ease;
  }

  #customclubnewsletter-{{ section.id }} .ccn__form-fields:focus-within {
    border-color: var(--ccn-accent);
    box-shadow: 0 0 0 2px {{ section.settings.accent_color | color_modify: 'alpha', 0.15 }};
  }

  #customclubnewsletter-{{ section.id }} .ccn__input-wrapper {
    min-width: 0;
    flex: 1 1 auto;
  }

  #customclubnewsletter-{{ section.id }} .ccn__input {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: {{ section.settings.input_height }}px;
    padding: 8px {{ section.settings.input_padding }}px;
    border: 0;
    border-radius: 0;
    outline: none;
    background: transparent;
    color: var(--ccn-input-text);
    font-family: inherit;
    font-size: {{ section.settings.input_font_size }}px;
    line-height: 1.4;
    appearance: none;
  }

  #customclubnewsletter-{{ section.id }} .ccn__input::placeholder {
    color: var(--ccn-placeholder);
    opacity: 1;
  }

  #customclubnewsletter-{{ section.id }} .ccn__button {
    display: inline-flex;
    min-width: {{ section.settings.button_min_width }}px;
    min-height: {{ section.settings.button_height }}px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px {{ section.settings.button_padding }}px;
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: var(--ccn-button-radius);
    background: var(--ccn-button-bg);
    color: var(--ccn-button-text);
    font-family: inherit;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_weight }};
    line-height: 1.3;
    text-align: center;
    cursor: pointer;
    appearance: none;
    transition:
      background 180ms ease,
      color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  #customclubnewsletter-{{ section.id }} .ccn__button:hover {
    border-color: {{ section.settings.button_hover_border_color }};
    background: var(--ccn-button-hover-bg);
    color: var(--ccn-button-hover-text);
  }

  #customclubnewsletter-{{ section.id }} .ccn__button:active {
    transform: scale(.98);
  }

  #customclubnewsletter-{{ section.id }} .ccn__button:focus-visible {
    outline: 2px solid var(--ccn-accent);
    outline-offset: 3px;
  }

  #customclubnewsletter-{{ section.id }} .ccn__button svg {
    width: 17px;
    height: 17px;
    flex: 0 0 17px;
  }

  #customclubnewsletter-{{ section.id }} .ccn__message {
    display: flex;
    align-items: center;
    gap: 10px;
    width: 100%;
    padding: 14px 18px;
    border-radius: var(--ccn-form-radius);
    font-size: 14px;
    line-height: 1.5;
    text-align: left;
  }

  #customclubnewsletter-{{ section.id }} .ccn__message svg {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  #customclubnewsletter-{{ section.id }} .ccn__message--success {
    background: {{ section.settings.success_background }};
    color: {{ section.settings.success_text }};
  }

  #customclubnewsletter-{{ section.id }} .ccn__message--error {
    background: {{ section.settings.error_background }};
    color: {{ section.settings.error_text }};
  }

  /* Divider */

  #customclubnewsletter-{{ section.id }} .ccn__divider {
    width: 100%;
    height: 1px;
    display: block;
    margin: {{ section.settings.divider_spacing }}px 0;
    background: {{ section.settings.divider_color }};
  }

  /* Benefits */

  #customclubnewsletter-{{ section.id }} .ccn__benefits {
    display: grid;
    grid-template-columns: repeat({{ section.settings.benefit_columns }}, minmax(0, 1fr));
    gap: {{ section.settings.benefit_gap }}px;
    width: 100%;
  }

  #customclubnewsletter-{{ section.id }} .ccn__benefit {
    display: flex;
    min-width: 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  #customclubnewsletter-{{ section.id }} .ccn__benefit-icon {
    display: flex;
    width: {{ section.settings.icon_size }}px;
    height: {{ section.settings.icon_size }}px;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ section.settings.icon_spacing }}px;
    border: {{ section.settings.icon_border_width }}px solid {{ section.settings.icon_border_color }};
    border-radius: {{ section.settings.icon_radius }}px;
    background: var(--ccn-icon-bg);
    color: var(--ccn-accent);
  }

  #customclubnewsletter-{{ section.id }} .ccn__benefit-icon svg {
    display: block;
    width: {{ section.settings.icon_inner_size }}px;
    height: {{ section.settings.icon_inner_size }}px;
  }

  #customclubnewsletter-{{ section.id }} .ccn__benefit-title {
    margin: 0;
    color: var(--ccn-text);
    font-family: {{ section.settings.heading_font }};
    font-size: {{ section.settings.benefit_title_size }}px;
    font-weight: {{ section.settings.benefit_title_weight }};
    line-height: 1.4;
  }

  #customclubnewsletter-{{ section.id }} .ccn__benefit-description {
    max-width: {{ section.settings.benefit_description_width }}px;
    margin: {{ section.settings.benefit_description_spacing }}px 0 0;
    color: var(--ccn-muted);
    font-size: {{ section.settings.benefit_description_size }}px;
    line-height: 1.55;
  }

  #customclubnewsletter-{{ section.id }} .ccn__bottom-note {
    margin-top: {{ section.settings.bottom_note_spacing }}px;
    color: var(--ccn-muted);
    font-size: {{ section.settings.bottom_note_size }}px;
    line-height: 1.5;
  }

  #customclubnewsletter-{{ section.id }} .ccn__visually-hidden {
    position: absolute !important;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    clip-path: inset(50%);
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    #customclubnewsletter-{{ section.id }} .ccn__container {
      padding-right: {{ section.settings.tablet_container_padding }}px;
      padding-left: {{ section.settings.tablet_container_padding }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__heading {
      font-size: {{ section.settings.tablet_heading_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefits {
      gap: {{ section.settings.tablet_benefit_gap }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-title {
      font-size: {{ section.settings.tablet_benefit_title_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-description {
      font-size: {{ section.settings.tablet_benefit_description_size }}px;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #customclubnewsletter-{{ section.id }} {
      padding-top: {{ section.settings.mobile_padding_top }}px;
      padding-bottom: {{ section.settings.mobile_padding_bottom }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__container {
      padding-right: {{ section.settings.mobile_container_padding }}px;
      padding-left: {{ section.settings.mobile_container_padding }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__heading {
      font-size: {{ section.settings.mobile_heading_size }}px;
      line-height: 1.2;
    }

    #customclubnewsletter-{{ section.id }} .ccn__description {
      margin-top: {{ section.settings.mobile_description_spacing }}px;
      font-size: {{ section.settings.mobile_description_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__form-wrapper {
      margin-top: {{ section.settings.mobile_form_spacing }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__form-fields {
      flex-direction: {{ section.settings.mobile_form_layout }};
      align-items: stretch;
      gap: {{ section.settings.mobile_form_gap }}px;
      padding: {{ section.settings.mobile_form_padding }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__input {
      min-height: {{ section.settings.mobile_input_height }}px;
      padding-right: 12px;
      padding-left: 12px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__button {
      width: 100%;
      min-width: 0;
      min-height: {{ section.settings.mobile_button_height }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__divider {
      margin-top: {{ section.settings.mobile_divider_spacing }}px;
      display:block;
      margin-bottom: {{ section.settings.mobile_divider_spacing }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefits {
      grid-template-columns: repeat({{ section.settings.mobile_benefit_columns }}, minmax(0, 1fr));
      gap: {{ section.settings.mobile_benefit_gap }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-icon {
      width: {{ section.settings.mobile_icon_size }}px;
      height: {{ section.settings.mobile_icon_size }}px;
      margin-bottom: 10px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-icon svg {
      width: {{ section.settings.mobile_icon_inner_size }}px;
      height: {{ section.settings.mobile_icon_inner_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-title {
      font-size: {{ section.settings.mobile_benefit_title_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__benefit-description {
      margin-top: 5px;
      font-size: {{ section.settings.mobile_benefit_description_size }}px;
    }

    #customclubnewsletter-{{ section.id }} .ccn__bottom-note {
      margin-top: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #customclubnewsletter-{{ section.id }} *,
    #customclubnewsletter-{{ section.id }} *::before,
    #customclubnewsletter-{{ section.id }} *::after {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('customclubnewsletter-{{ section.id }}');

    if (!root || root.dataset.initialized === 'true') return;

    root.dataset.initialized = 'true';

    const form = root.querySelector('.ccn__form');
    const input = root.querySelector('.ccn__input');
    const successMessage = root.querySelector('.ccn__message--success');

    if (form && input) {
      input.addEventListener('input', () => {
        input.removeAttribute('aria-invalid');
      });
    }

    if (successMessage) {
      successMessage.focus({ preventScroll: true });
    }
  })();
</script>

{% schema %}
{
  "name": "Custom Club Newsletter",
  "tag": "section",
  "class": "section-custom-club-newsletter",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "TRAIL CLUB"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading_before",
      "label": "Heading text",
      "default": "Gear up with the"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Heading highlighted text",
      "default": "club"
    },
    {
      "type": "select",
      "id": "heading_tag",
